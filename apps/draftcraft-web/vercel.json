{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.+mobile|windows phone|iemobile|opera mini|blackberry).*"
        }
      ],
      "missing": [{ "type": "query", "key": "desktop" }],
      "destination": "/viewer.html"
    },
    {
      "source": "/index.html",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(iphone|ipod|android.+mobile|windows phone|iemobile|opera mini|blackberry).*"
        }
      ],
      "missing": [{ "type": "query", "key": "desktop" }],
      "destination": "/viewer.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(wasm|js|css)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Vary", "value": "User-Agent" }
      ]
    },
    {
      "source": "/(index|viewer)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Vary", "value": "User-Agent" }
      ]
    }
  ]
}
