{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)\\.(wasm|js|css)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/(index\\.html|viewer\\.html)?",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate", "Vary": "User-Agent" },
      "continue": true
    },
    {
      "src": "/(index\\.html)?",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(iPhone|iPod|Android.+Mobile|Windows Phone|IEMobile|Opera Mini|BlackBerry|Mobile.+Firefox).*"
        }
      ],
      "missing": [{ "type": "query", "key": "desktop" }],
      "dest": "/viewer.html"
    }
  ]
}
